# Server
PORT=8787
HOST=0.0.0.0

# Binaries (kosongkan kalau ffmpeg/yt-dlp sudah ada di PATH)
# Windows contoh: D:/tools/ffmpeg.exe
FFMPEG_PATH=
YTDLP_PATH=

# Optional: cookies/proxy untuk sumber yang butuh sesi
YTDLP_COOKIES=
YTDLP_PROXY=

# Admin accounts
OWNER_USER=owner
OWNER_PASS=antibypass
ADMIN_USER=admin
ADMIN_PASS=admin123

# Limits
CONCURRENCY=2
JOB_TIMEOUT_SEC=420
MAX_UPLOAD_MB=60
MAX_OUTPUT_MB=200

# Optional: override data directory
DATA_DIR=
